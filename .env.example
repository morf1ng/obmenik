# Публичные значения из окна Connect. Их можно видеть в браузере.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Секретный ключ. Его нет в окне Connect.
# Project Settings → API Keys → Secret keys. Только сервер, не коммитить.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Необязательно. Если пусто, npm run seed печатает случайный пароль один раз.
# Не используйте боевой пароль и не коммитьте заполненный .env.local.
DEMO_PASSWORD=
