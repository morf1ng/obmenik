# Публичные ключи проекта Supabase. Их можно видеть в браузере.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Только сервер: Vercel Environment Variables и локальный .env.local.
# Не добавляйте этот ключ в клиентский код и не коммитьте .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Необязательно. Если пусто, npm run seed печатает случайный пароль один раз.
# Не используйте боевой пароль и не коммитьте заполненный .env.local.
DEMO_PASSWORD=
